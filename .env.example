# Copy to .env to override defaults. All are optional for the demo.

# RAG generation. Default is the built-in deterministic grounded provider (no key).
# Set to "anthropic" and provide a key to use a real model.
LLM_PROVIDER=extractive
# ANTHROPIC_API_KEY=sk-ant-...
# LLM_MODEL=claude-3-5-haiku-latest

# ML backends. "hash"/"lexical" are deterministic and need no model download.
# Set both to "auto" (and build mlservice with the full requirements) for real models.
EMBED_BACKEND=hash
RERANK_BACKEND=lexical
