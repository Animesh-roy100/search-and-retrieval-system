# Copy to .env to override defaults. All are optional for the demo.

# RAG generation. Default is the built-in deterministic grounded provider (no key).
# For a real model, use the LiteLLM proxy (LLM_PROVIDER=litellm) — see the LiteLLM
# section below. Provider API keys are read by the litellm container, not the app.
LLM_PROVIDER=extractive

# ML backends. "hash"/"lexical" are deterministic and need no model download.
# Set both to "auto" (and build mlservice with the full requirements) for real models.
EMBED_BACKEND=hash
RERANK_BACKEND=lexical

# Semantic answer cache (Qdrant-backed). Matches paraphrases above the cosine
# threshold; scoped by tenant + cache generation. Set SEM_CACHE=false to disable.
# NOTE: paraphrase matching needs real embeddings (EMBED_BACKEND=auto); with the
# hash backend only near-identical queries match.
SEM_CACHE=true
SEM_CACHE_THRESHOLD=0.95

# Faithfulness judge. "lexical" (default, deterministic) or "llm" (uses the LLM
# provider's judge; requires a real provider via LiteLLM, falls back to lexical).
FAITHFULNESS_MODE=lexical

# Optional: route embeddings + reranking to Hugging Face Text-Embeddings-Inference
# (high-throughput Rust inference). Set both to enable; unset = use the Python ML
# service. TEI CPU images are amd64-only — on Apple Silicon keep these unset and use
# the native Python backend; enable on an amd64/GPU host for the real speedup.
# TEI_EMBED_URL=http://tei-embed:80
# TEI_RERANK_URL=http://tei-rerank:80

# LiteLLM proxy — one OpenAI-compatible endpoint over all providers. Set
# LLM_PROVIDER=litellm and LLM_MODEL to a model_name from deploy/litellm/config.yaml
# (e.g. gemini-flash). Provider keys (GEMINI_API_KEY, ANTHROPIC_API_KEY, ...) are read
# by the litellm container. LITELLM_URL/LITELLM_API_KEY default to the compose service.
# LLM_PROVIDER=litellm
# LLM_MODEL=gemini-flash

# Fully-local, keyless LLM via Ollama (no provider quotas). After `make up`:
#   docker compose exec ollama ollama pull llama3.2:3b
# then set:
# LLM_PROVIDER=litellm
# LLM_MODEL=local
# REQUEST_TIMEOUT=180s   # local CPU generation is slower than the 5s default
