# Copy to .env to override defaults. All are optional for the demo.

# RAG generation. Default is the built-in deterministic grounded provider (no key).
# Set to "anthropic" and provide a key to use a real model.
LLM_PROVIDER=extractive
# ANTHROPIC_API_KEY=sk-ant-...
# LLM_MODEL=claude-3-5-haiku-latest

# ML backends. "hash"/"lexical" are deterministic and need no model download.
# Set both to "auto" (and build mlservice with the full requirements) for real models.
EMBED_BACKEND=hash
RERANK_BACKEND=lexical

# Semantic answer cache (Qdrant-backed). Matches paraphrases above the cosine
# threshold; scoped by tenant + cache generation. Set SEM_CACHE=false to disable.
# NOTE: paraphrase matching needs real embeddings (EMBED_BACKEND=auto); with the
# hash backend only near-identical queries match.
SEM_CACHE=true
SEM_CACHE_THRESHOLD=0.95

# Faithfulness judge. "lexical" (default, deterministic) or "llm" (uses the LLM
# provider's judge; requires LLM_PROVIDER=anthropic + key, falls back to lexical).
FAITHFULNESS_MODE=lexical
