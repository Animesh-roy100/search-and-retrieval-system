{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://retrieval.local/schemas/canonical_doc.json",
  "title": "CanonicalDoc",
  "description": "The multi-source contract. Every source normalizes to this shape before Redpanda. Downstream code only ever sees this.",
  "type": "object",
  "required": ["source", "source_id", "doc_id", "tenant_id", "op", "tier", "version", "commit_ts"],
  "properties": {
    "source":    { "type": "string", "description": "provenance; also a filterable facet", "examples": ["postgres", "s3"] },
    "source_id": { "type": "string", "description": "native id within the source, e.g. documents:42" },
    "doc_id":    { "type": "string", "description": "globally unique = {source}:{native_id}[:chunk]" },
    "tenant_id": { "type": "integer", "minimum": 0 },
    "op":        { "type": "string", "enum": ["upsert", "delete"] },
    "tier":      { "type": "string", "enum": ["urgent", "bulk"] },
    "version":   { "type": "integer", "minimum": 0, "description": "per-source monotonic (LSN / ETag / updated_at)" },
    "commit_ts": { "type": "string", "format": "date-time", "description": "per-source freshness clock start" },
    "title":     { "type": "string" },
    "body":      { "type": "string" },
    "chunk_id":  { "type": "integer", "minimum": 0, "description": "for unstructured sources split into chunks" },
    "metadata":  {
      "type": "object",
      "properties": {
        "category": { "type": "string" },
        "url":      { "type": "string" },
        "author":   { "type": "string" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
